+
+	/**
+	 * @testdox should_hydrate returns false for anonymous requests with an empty cart.
+	 */
+	public function test_should_hydrate_false_for_anonymous_empty_cart(): void {
+		wp_set_current_user( 0 );
+		WC()->cart->empty_cart();
