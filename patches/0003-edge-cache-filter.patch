+				array(
+					'type'       => 'cart',
+					'sourceData' => array( 'productIds' => array() ),
+				),
+				$context['productCollectionLocation']
+			);
+
+			$parsed_block['attrs']['productCollectionLocation'] = $context['productCollectionLocation'];
+			$query = Utils::initialize_merged_query( new ProductCollectionMock(), $parsed_block );
+			$this->assertEmpty( array_intersect( array( 101, 102 ), $query['post__in'] ?? array() ), 'Cross-sells from the cart must not be rendered.' );
