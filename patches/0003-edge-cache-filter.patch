+	/**
+	 * @testdox Should leave cart products out of the cart context when personalized data must not be embedded.
+	 */
+	public function test_cart_context_is_empty_when_not_hydrating(): void {
+		$cart_product = WC_Helper_Product::create_simple_product();
+		$cart_product->set_cross_sell_ids( array( 101, 102 ) );
+		$cart_product->save();
+		WC()->cart->add_to_cart( $cart_product->get_id() );
+		add_filter( 'woocommerce_embed_personalized_data', '__return_false' );
+
+		try {
