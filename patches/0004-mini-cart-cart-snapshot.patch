+++ b/plugins/woocommerce/client/blocks/assets/js/base/stores/woocommerce/test/cart-snapshot.ts
@@ -0,0 +1,181 @@
+/**
+ * External dependencies
+ */
+import type { CartResponseTotals } from '@woocommerce/types';
+
+/**
+ * Internal dependencies
+ */
+import {
+	CART_SNAPSHOT_MAX_AGE,
+	CART_SNAPSHOT_STORAGE_KEY,
+	hasCartSessionCookie,
+	readCartSnapshot,
+	saveCartSnapshot,
+	seedCartFromSnapshot,
+} from '../cart-snapshot';
+
+const totals = {
+	total_items: '2000',
+	total_price: '2300',
+	currency_code: 'USD',
+} as unknown as CartResponseTotals;
+
+const setItemsInCartCookie = () => {
+	document.cookie = 'woocommerce_items_in_cart=1; path=/';
+};
+
+const clearItemsInCartCookie = () => {
+	document.cookie =
+		'woocommerce_items_in_cart=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
+};
+
+const emptyCart = () => ( {
+	items: [] as unknown[],
+	items_count: 0,
+	items_weight: 0,
+	totals: { currency_code: 'USD' } as unknown as CartResponseTotals,
+} );
+
+describe( 'cart snapshot', () => {
+	beforeEach( () => {
+		window.localStorage.clear();
+		clearItemsInCartCookie();
+	} );
+
+	afterEach( () => {
+		jest.restoreAllMocks();
+	} );
+
+	describe( 'hasCartSessionCookie', () => {
+		it( 'is true only while the items-in-cart cookie is set', () => {
+			expect( hasCartSessionCookie() ).toBe( false );
+			setItemsInCartCookie();
+			expect( hasCartSessionCookie() ).toBe( true );
+		} );
+	} );
+
+	describe( 'saveCartSnapshot', () => {
+		it( 'stores only the aggregate fields', () => {
+			saveCartSnapshot( {
+				items_count: 3,
+				items_weight: 1.5,
+				totals,
+				// Extra fields from the full cart response must not be stored.
+				billing_address: { email: 'shopper@example.com' },
+				items: [ { name: 'Hoodie' } ],
+			} as never );
+
+			const stored = JSON.parse(
+				window.localStorage.getItem( CART_SNAPSHOT_STORAGE_KEY ) || ''
+			);
+			expect( Object.keys( stored ).sort() ).toEqual( [
+				'items_count',
+				'items_weight',
+				'saved_at',
+				'totals',
+			] );
+			expect( stored.items_count ).toBe( 3 );
+			expect( stored.totals ).toEqual( totals );
+		} );
+
+		it( 'clears the snapshot when the cart is empty', () => {
+			saveCartSnapshot( { items_count: 2, items_weight: 0, totals } );
+			saveCartSnapshot( { items_count: 0, items_weight: 0, totals } );
+
+			expect(
+				window.localStorage.getItem( CART_SNAPSHOT_STORAGE_KEY )
+			).toBeNull();
+		} );
+
+		it( 'ignores storage errors', () => {
+			jest.spyOn( Storage.prototype, 'setItem' ).mockImplementation(
+				() => {
+					throw new Error( 'QuotaExceededError' );
+				}
+			);
+
+			expect( () =>
+				saveCartSnapshot( { items_count: 1, items_weight: 0, totals } )
+			).not.toThrow();
+		} );
+	} );
+
+	describe( 'readCartSnapshot', () => {
+		it( 'returns a saved snapshot while the cart cookie is set', () => {
+			setItemsInCartCookie();
+			saveCartSnapshot( { items_count: 2, items_weight: 0, totals } );
+
+			expect( readCartSnapshot() ).toMatchObject( {
+				items_count: 2,
+				totals,
+			} );
+		} );
+
+		it( 'returns null and clears the snapshot without the cart cookie', () => {
+			saveCartSnapshot( { items_count: 2, items_weight: 0, totals } );
+
+			expect( readCartSnapshot() ).toBeNull();
+			expect(
+				window.localStorage.getItem( CART_SNAPSHOT_STORAGE_KEY )
+			).toBeNull();
+		} );
+
+		it( 'returns null for an expired snapshot', () => {
+			setItemsInCartCookie();
+			saveCartSnapshot( { items_count: 2, items_weight: 0, totals } );
+			jest.spyOn( Date, 'now' ).mockReturnValue(
+				Date.now() + CART_SNAPSHOT_MAX_AGE + 1
+			);
+
+			expect( readCartSnapshot() ).toBeNull();
+		} );
+
+		it( 'returns null for malformed data', () => {
+			setItemsInCartCookie();
+			window.localStorage.setItem( CART_SNAPSHOT_STORAGE_KEY, '{oops' );
+			expect( readCartSnapshot() ).toBeNull();
+
+			window.localStorage.setItem(
+				CART_SNAPSHOT_STORAGE_KEY,
+				JSON.stringify( { items_count: '2', totals } )
+			);
+			expect( readCartSnapshot() ).toBeNull();
+		} );
+	} );
+
+	describe( 'seedCartFromSnapshot', () => {
+		it( 'seeds count and totals onto an empty server cart, not items', () => {
+			setItemsInCartCookie();
+			saveCartSnapshot( { items_count: 4, items_weight: 2, totals } );
+			const cart = emptyCart();
+
+			expect( seedCartFromSnapshot( cart ) ).toBe( true );
+			expect( cart.items ).toEqual( [] );
+			expect( cart.items_count ).toBe( 4 );
+			expect( cart.items_weight ).toBe( 2 );
+			expect( cart.totals ).toMatchObject( totals );
+		} );
+
+		it( 'does not touch a cart the server rendered with items', () => {
+			setItemsInCartCookie();
+			saveCartSnapshot( { items_count: 4, items_weight: 0, totals } );
+			const cart = {
+				...emptyCart(),
+				items: [ { key: 'abc', quantity: 1 } ],
+				items_count: 1,
+			};
+
+			expect( seedCartFromSnapshot( cart ) ).toBe( false );
+			expect( cart.items_count ).toBe( 1 );
+		} );
+
+		it( 'does nothing without a valid snapshot', () => {
+			const cart = emptyCart();
+
+			expect( seedCartFromSnapshot( cart ) ).toBe( false );
+			expect( seedCartFromSnapshot( undefined ) ).toBe( false );
+			expect( cart.items_count ).toBe( 0 );
+		} );
+	} );
+} );
