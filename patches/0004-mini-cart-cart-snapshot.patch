@@ -0,0 +1,189 @@
+/**
+ * External dependencies
+ */
+import type { CartResponseTotals } from '@woocommerce/types';
+
+/**
+ * Persists a minimal cart summary (item count, weight and totals) to
+ * localStorage so the Mini-Cart can show the shopper's real count and subtotal
+ * on the first paint of a page rendered without per-user data, for example a
+ * page served from a shared cache. The live `GET /cart` refresh always runs
+ * afterwards and replaces the seeded values.
+ *
+ * Only aggregate values are stored: no line items, addresses or other
+ * personal data.
+ */
+
+export const CART_SNAPSHOT_STORAGE_KEY = 'wcBlocksCartSnapshot';
+
+/**
+ * Snapshots older than this are ignored. Matches the default WooCommerce
+ * session expiration (48 hours).
+ */
+export const CART_SNAPSHOT_MAX_AGE = 2 * 24 * 60 * 60 * 1000;
+
+/**
+ * Cookie WooCommerce sets while the session has a non-empty cart and clears
+ * when the cart is emptied, the order is placed or the session ends.
+ */
+const ITEMS_IN_CART_COOKIE = 'woocommerce_items_in_cart';
+
+export type CartSnapshot = {
+	items_count: number;
+	items_weight: number;
+	totals: CartResponseTotals;
+	saved_at: number;
+};
+
+/**
+ * The Store API cart response (snake_case). Typed loosely because the iAPI
+ * store holds the raw response under the camelCase `Cart` type.
+ */
+type CartLike = {
+	items?: unknown;
+	items_count?: unknown;
+	items_weight?: unknown;
+	totals?: unknown;
+};
+
+const getStorage = (): Storage | null => {
+	try {
+		return window.localStorage ?? null;
+	} catch {
+		// Accessing localStorage throws when storage is disabled.
+		return null;
+	}
+};
+
+export const hasCartSessionCookie = (): boolean => {
+	try {
+		return document.cookie.split( ';' ).some( ( cookie ) => {
+			const [ name, value ] = cookie.split( '=' );
+			return (
+				name.trim() === ITEMS_IN_CART_COOKIE &&
+				!! value?.trim() &&
+				value.trim() !== '0'
+			);
+		} );
+	} catch {
+		return false;
+	}
+};
+
+export const clearCartSnapshot = (): void => {
+	try {
+		getStorage()?.removeItem( CART_SNAPSHOT_STORAGE_KEY );
+	} catch {}
+};
+
+/**
+ * Saves the summary of a server cart response, or clears it when the cart is
+ * empty. Best-effort: storage errors (private mode, quota) are ignored.
+ *
+ * @param cart Cart returned by the Store API.
+ */
+export const saveCartSnapshot = ( cart: CartLike | null | undefined ): void => {
+	if ( ! cart || ! ( Number( cart.items_count ) > 0 ) || ! cart.totals ) {
+		clearCartSnapshot();
+		return;
+	}
+
+	const snapshot: CartSnapshot = {
+		items_count: Number( cart.items_count ),
+		items_weight: Number( cart.items_weight ) || 0,
+		totals: cart.totals as CartResponseTotals,
+		saved_at: Date.now(),
+	};
+
+	try {
+		getStorage()?.setItem(
+			CART_SNAPSHOT_STORAGE_KEY,
+			JSON.stringify( snapshot )
+		);
+	} catch {}
+};
+
+/**
+ * Returns the stored snapshot when it is still trustworthy: the cart cookie
+ * says the session has items, and the snapshot is well-formed and recent.
+ * Clears snapshots that fail these checks.
+ */
+export const readCartSnapshot = (): CartSnapshot | null => {
+	const storage = getStorage();
+	if ( ! storage ) {
+		return null;
+	}
+
+	let raw: string | null = null;
+	try {
+		raw = storage.getItem( CART_SNAPSHOT_STORAGE_KEY );
+	} catch {
+		return null;
+	}
+
+	if ( ! raw ) {
+		return null;
+	}
+
+	if ( ! hasCartSessionCookie() ) {
+		clearCartSnapshot();
+		return null;
+	}
+
+	let parsed: Partial< CartSnapshot > | null = null;
+	try {
+		parsed = JSON.parse( raw );
+	} catch {
+		parsed = null;
+	}
+
+	const isValid =
+		!! parsed &&
+		typeof parsed === 'object' &&
+		typeof parsed.items_count === 'number' &&
+		parsed.items_count > 0 &&
+		typeof parsed.saved_at === 'number' &&
+		Date.now() - parsed.saved_at < CART_SNAPSHOT_MAX_AGE &&
+		!! parsed.totals &&
+		typeof parsed.totals === 'object';
+
+	if ( ! isValid ) {
+		clearCartSnapshot();
+		return null;
+	}
+
+	return parsed as CartSnapshot;
+};
+
+/**
+ * Copies the stored summary onto a cart the server rendered empty.
+ *
+ * Only scalar fields are seeded: seeding `items` would mismatch the empty
+ * `data-wp-each` templates the server rendered.
+ *
+ * @param cart Cart state to seed in place.
+ * @return Whether the cart was seeded.
+ */
+export const seedCartFromSnapshot = ( cart: CartLike | undefined ): boolean => {
+	if (
+		! cart ||
+		! Array.isArray( cart.items ) ||
+		cart.items.length > 0 ||
+		Number( cart.items_count ) > 0
+	) {
+		return false;
+	}
+
+	const snapshot = readCartSnapshot();
+	if ( ! snapshot ) {
+		return false;
+	}
+
+	cart.items_count = snapshot.items_count;
+	cart.items_weight = snapshot.items_weight;
+	cart.totals = {
+		...( cart.totals as CartResponseTotals | undefined ),
+		...snapshot.totals,
+	};
+	return true;
+};
