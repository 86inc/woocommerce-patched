+/**
+ * External dependencies
+ */
+import { __, sprintf } from '@wordpress/i18n';
+import { useMemo } from '@wordpress/element';
+import { applyCheckoutFilter } from '@woocommerce/blocks-checkout';
+import type { CartImageItem, CartItem } from '@woocommerce/types';
+import type { ReactElement } from 'react';
+
+/**
+ * Internal dependencies
+ */
+import ProductImage from '../product-image';
+import './style.scss';
+
+/**
+ * Accepts only an array of image objects. Anything else keeps the default.
+ *
+ * @param value Value returned by the `cartItemImages` filter.
+ */
+export const cartItemImagesValidation = ( value: unknown ): true => {
+	if (
+		! Array.isArray( value ) ||
+		! value.every(
+			( image ) =>
+				!! image &&
+				typeof image === 'object' &&
+				! Array.isArray( image )
+		)
+	) {
+		throw new Error(
+			__(
+				'The cartItemImages filter must return an array of image objects.',
+				'woocommerce'
+			)
+		);
+	}
+	return true;
+};
+
+/**
+ * Returns the images to display for a cart item: the first image by default,
+ * or the list returned by the `cartItemImages` checkout filter.
+ *
+ * @param props            Hook arguments.
+ * @param props.images     All images of the cart item.
+ * @param props.extensions Extension data of the cart item.
+ * @param props.arg        Filter arguments (`context`, `cartItem`, `cart`).
+ */
+export const useCartItemImages = ( {
+	images,
+	extensions,
+	arg,
+}: {
+	images: CartItem[ 'images' ];
+	extensions: Record< string, unknown >;
+	arg: Record< string, unknown >;
+} ): CartImageItem[] => {
+	const defaultValue = useMemo(
+		() => ( images.length ? images.slice( 0, 1 ) : [] ),
+		[ images ]
+	);
+
+	return applyCheckoutFilter< CartImageItem[] >( {
+		filterName: 'cartItemImages',
+		defaultValue,
+		extensions,
+		arg,
+		validation: cartItemImagesValidation,
+	} );
+};
+
+interface ProductImagesProps {
+	images: CartImageItem[];
+	fallbackAlt: string;
+	width?: number;
+	height?: number;
+}
+
+/**
+ * Renders one product image, or a horizontally scrolling list when there is
+ * more than one. With zero or one image the markup matches `ProductImage`.
+ *
+ * @param props             Component props.
+ * @param props.images      Images to render.
+ * @param props.fallbackAlt Alt text used when an image has none.
+ * @param props.width       Display width of each image.
+ * @param props.height      Display height of each image.
+ */
+const ProductImages = ( {
+	images,
+	fallbackAlt,
+	width,
+	height,
+}: ProductImagesProps ): ReactElement => {
+	const sizeProps = {
+		...( width === undefined ? {} : { width } ),
+		...( height === undefined ? {} : { height } ),
+	};
+
+	if ( images.length < 2 ) {
+		return (
+			<ProductImage
+				image={ images[ 0 ] || {} }
+				fallbackAlt={ fallbackAlt }
+				{ ...sizeProps }
+			/>
+		);
+	}
+
+	return (
+		<ul
+			className="wc-block-components-product-images"
+			style={ width ? { width } : undefined }
+		>
+			{ images.map( ( image, index ) => (
+				<li
+					// Images may repeat, so the position is part of the key.
+					key={ `${ image.id }-${ index }` }
+					className="wc-block-components-product-images__item"
+				>
+					<ProductImage
+						image={ image }
+						fallbackAlt={ sprintf(
+							/* translators: 1: product name, 2: image number, 3: number of images. */
+							__( '%1$s, image %2$d of %3$d', 'woocommerce' ),
+							fallbackAlt,
+							index + 1,
+							images.length
+						) }
+						{ ...sizeProps }
+					/>
+				</li>
+			) ) }
+		</ul>
+	);
+};
+
+export default ProductImages;
