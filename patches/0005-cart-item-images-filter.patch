+/**
+ * External dependencies
+ */
+import { render, renderHook, screen } from '@testing-library/react';
+import { registerCheckoutFilters } from '@woocommerce/blocks-checkout';
+import type { CartImageItem, CartItem } from '@woocommerce/types';
+
+/**
+ * Internal dependencies
+ */
+import ProductImages, { cartItemImagesValidation, useCartItemImages } from '..';
+
+const buildImage = ( id: number ): CartImageItem => ( {
+	id,
+	src: `https://example.org/${ id }.jpg`,
+	thumbnail: `https://example.org/${ id }-thumb.jpg`,
+	srcset: '',
+	sizes: '',
+	thumbnail_srcset: '',
+	thumbnail_sizes: '',
+	name: `${ id }.jpg`,
+	alt: `Image ${ id }`,
+} );
+
+const images = [ buildImage( 1 ), buildImage( 2 ), buildImage( 3 ) ];
+
+const buildArg = ( key: string, context = 'cart' ) => ( {
+	context,
+	cartItem: { key, images } as unknown as CartItem,
+} );
+
+describe( 'ProductImages', () => {
+	it( 'renders a single image without a list', () => {
+		const { container } = render(
+			<ProductImages images={ [ images[ 0 ] ] } fallbackAlt="Hoodie" />
+		);
+
+		expect( container.querySelector( 'ul' ) ).toBeNull();
+		expect( screen.getAllByRole( 'img' ) ).toHaveLength( 1 );
+		expect( screen.getByRole( 'img' ) ).toHaveAttribute(
+			'src',
+			images[ 0 ].thumbnail
+		);
+	} );
+
+	it( 'renders the placeholder when there are no images', () => {
+		const { container } = render(
+			<ProductImages images={ [] } fallbackAlt="Hoodie" />
+		);
+
+		expect( container.querySelector( 'ul' ) ).toBeNull();
+		expect( container.querySelectorAll( 'img' ) ).toHaveLength( 1 );
+	} );
+
+	it( 'renders a list when there is more than one image', () => {
+		const { container } = render(
+			<ProductImages images={ images } fallbackAlt="Hoodie" />
+		);
+
+		const list = container.querySelector(
+			'ul.wc-block-components-product-images'
+		);
+		expect( list ).not.toBeNull();
+		expect(
+			list?.querySelectorAll(
+				'.wc-block-components-product-images__item'
+			)
+		).toHaveLength( 3 );
+		expect(
+			screen
+				.getAllByRole( 'img' )
+				.map( ( img ) => img.getAttribute( 'src' ) )
+		).toEqual( images.map( ( image ) => image.thumbnail ) );
+	} );
+} );
+
+describe( 'cartItemImagesValidation', () => {
+	it( 'accepts an array of image objects', () => {
+		expect( cartItemImagesValidation( images ) ).toBe( true );
+		expect( cartItemImagesValidation( [] ) ).toBe( true );
+	} );
+
+	it.each( [
+		[ 'an object', { 0: images[ 0 ] } ],
+		[ 'an array of strings', [ 'a.jpg' ] ],
+		[ 'an array containing null', [ images[ 0 ], null ] ],
+	] )( 'rejects %s', ( _label, value ) => {
+		expect( () => cartItemImagesValidation( value ) ).toThrow();
+	} );
+} );
+
+describe( 'useCartItemImages', () => {
+	it( 'returns the first image when no filter changes it', () => {
+		const { result } = renderHook( () =>
+			useCartItemImages( {
+				images,
+				extensions: {},
+				arg: buildArg( 'no-filter' ),
+			} )
+		);
+
+		expect( result.current ).toEqual( [ images[ 0 ] ] );
+	} );
+
+	it( 'returns an empty list for an item without images', () => {
+		const { result } = renderHook( () =>
+			useCartItemImages( {
+				images: [],
+				extensions: {},
+				arg: buildArg( 'no-images' ),
+			} )
+		);
+
+		expect( result.current ).toEqual( [] );
+	} );
+
+	it( 'returns the images chosen by the cartItemImages filter, with its arguments', () => {
+		const filter = jest.fn(
+			(
+				defaultValue: CartImageItem[],
+				extensions: Record< string, unknown >,
+				args: ReturnType< typeof buildArg >
+			) =>
+				extensions.example
+					? args.cartItem.images.slice( 0, 2 )
+					: defaultValue
+		);
+		registerCheckoutFilters( 'product-images-test', {
+			cartItemImages: filter as never,
+		} );
+
+		const arg = buildArg( 'filtered', 'summary' );
+		const { result } = renderHook( () =>
+			useCartItemImages( {
+				images,
+				extensions: { example: true },
+				arg,
+			} )
+		);
+
+		expect( result.current ).toEqual( [ images[ 0 ], images[ 1 ] ] );
+		expect( filter ).toHaveBeenCalledWith(
+			[ images[ 0 ] ],
+			{ example: true },
+			arg
+		);
+	} );
+
+	it( 'keeps the default when the filter returns an invalid value', () => {
+		const consoleError = jest
+			.spyOn( console, 'error' )
+			.mockImplementation( () => undefined );
+		registerCheckoutFilters( 'product-images-test-invalid', {
+			cartItemImages: () => [ 'not-an-image' ],
+		} );
+
+		const { result } = renderHook( () =>
+			useCartItemImages( {
+				images,
+				extensions: {},
+				arg: buildArg( 'invalid' ),
+			} )
+		);
+
+		expect( result.current ).toEqual( [ images[ 0 ] ] );
+		expect( consoleError ).toHaveBeenCalled();
+		consoleError.mockRestore();
+	} );
+} );
