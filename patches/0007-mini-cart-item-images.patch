+<?php
+declare( strict_types = 1 );
+
+namespace Automattic\WooCommerce\Tests\Blocks\BlockTypes;
+
+use WC_Unit_Test_Case;
+use WP_HTML_Tag_Processor;
+
+/**
+ * Tests for the Mini-Cart Products Table block's image markup.
+ */
+class MiniCartProductsTableBlockTest extends WC_Unit_Test_Case {
+
+	/**
+	 * Render the block on its own, without processing its directives.
+	 *
+	 * @return string
+	 */
+	private function render_table(): string {
+		$blocks = parse_blocks( '<!-- wp:woocommerce/mini-cart-products-table-block /-->' );
+		return render_block( $blocks[0] );
+	}
+
+	/**
+	 * Collect the attributes of every tag matching a query.
+	 *
+	 * @param string $html      Markup to scan.
+	 * @param array  $query     Tag processor query.
+	 * @param array  $attribute_names Attributes to read.
+	 * @return array<int, array<string, mixed>>
+	 */
+	private function collect_attributes( string $html, array $query, array $attribute_names ): array {
+		$processor = new WP_HTML_Tag_Processor( $html );
+		$found     = array();
+		while ( $processor->next_tag( $query ) ) {
+			$attributes = array();
+			foreach ( $attribute_names as $name ) {
+				$attributes[ $name ] = $processor->get_attribute( $name );
+			}
+			$found[] = $attributes;
+		}
+		return $found;
+	}
+
+	/**
+	 * @testdox The single image keeps its bindings, hidden only through the new image-count aware getters.
+	 */
+	public function test_single_image_bindings(): void {
+		$images = $this->collect_attributes(
+			$this->render_table(),
+			array( 'tag_name' => 'img' ),
+			array( 'data-wp-bind--hidden', 'data-wp-bind--src', 'data-wp-bind--alt', 'data-wp-on--error' )
+		);
+
+		$single = array_values(
+			array_filter(
+				$images,
+				static fn ( $image ) => 'state.itemThumbnail' === $image['data-wp-bind--src']
+			)
+		);
+
+		$this->assertCount( 2, $single, 'There should be one unlinked and one linked single image.' );
+		$this->assertSame( '!state.isUnlinkedImageShown', $single[0]['data-wp-bind--hidden'] );
+		$this->assertSame( 'state.isLinkedImageHidden', $single[1]['data-wp-bind--hidden'] );
+		foreach ( $single as $image ) {
+			$this->assertSame( 'state.cartItemName', $image['data-wp-bind--alt'] );
+			$this->assertSame( 'actions.hideImage', $image['data-wp-on--error'] );
+		}
+	}
+
+	/**
+	 * @testdox Both image lists are hidden unless an item has several images, and loop over state.itemImages.
+	 */
+	public function test_image_lists_are_hidden_by_default(): void {
+		$html  = $this->render_table();
+		$lists = $this->collect_attributes(
+			$html,
+			array(
+				'tag_name'   => 'ul',
+				'class_name' => 'wc-block-components-product-images',
+			),
+			array( 'data-wp-bind--hidden' )
+		);
+
+		$this->assertSame(
+			array( '!state.isUnlinkedImageListShown', '!state.hasMultipleImages' ),
+			array_column( $lists, 'data-wp-bind--hidden' ),
+			'Both lists must bind `hidden` to a negated getter so the server renders them hidden.'
+		);
+
+		$templates   = $this->collect_attributes(
+			$html,
+			array( 'tag_name' => 'template' ),
+			array( 'data-wp-each--item-image', 'data-wp-each-key' )
+		);
+		$image_loops = array_values(
+			array_filter(
+				$templates,
+				static fn ( $template ) => null !== $template['data-wp-each--item-image']
+			)
+		);
+
+		$this->assertCount( 2, $image_loops );
+		foreach ( $image_loops as $loop ) {
+			$this->assertSame( 'state.itemImages', $loop['data-wp-each--item-image'] );
+			$this->assertSame( 'state.listImageKey', $loop['data-wp-each-key'] );
+		}
+	}
+
+	/**
+	 * @testdox The linked image list sits inside the product link, after the single image.
+	 */
+	public function test_linked_list_is_inside_the_product_link(): void {
+		$html = $this->render_table();
+
+		$this->assertMatchesRegularExpression(
+			'#<a data-wp-bind--hidden="state.isProductHiddenFromCatalog"[^>]*>\s*<img[^>]*state.isLinkedImageHidden[^>]*>\s*<ul class="wc-block-components-product-images" data-wp-bind--hidden="!state.hasMultipleImages">#s',
+			$html
+		);
+	}
+
+	/**
+	 * @testdox The alt text template for list images is passed to the frontend.
+	 */
+	public function test_alt_template_is_in_config(): void {
+		$this->render_table();
+
+		$config = wp_interactivity_config( 'woocommerce/mini-cart-products-table-block' );
+
+		$this->assertSame( '%1$s, image %2$d of %3$d', $config['itemImageAltTemplate'] ?? null );
+	}
+}
