@@ -0,0 +1,194 @@
+/**
+ * External dependencies
+ */
+import {
+	applyCheckoutFilter,
+	registerCheckoutFilters,
+} from '@woocommerce/blocks-checkout';
+import type { CartImageItem } from '@woocommerce/types';
+
+/**
+ * Internal dependencies
+ */
+import {
+	cartItemImagesValidation,
+	getCartItemImages,
+	getItemImageAlt,
+	isCartItemImageList,
+	type ApplyCheckoutFilter,
+} from '../item-images';
+
+const image = ( id: number, alt = '' ): CartImageItem => ( {
+	id,
+	src: `https://example.com/${ id }.jpg`,
+	thumbnail: `https://example.com/${ id }-thumb.jpg`,
+	srcset: '',
+	sizes: '',
+	thumbnail_srcset: '',
+	thumbnail_sizes: '',
+	name: `${ id }.jpg`,
+	alt,
+} );
+
+const arg = { context: 'cart', cartItem: { key: 'abc' }, cart: {} };
+
+describe( 'isCartItemImageList', () => {
+	test( 'accepts an array of objects, including an empty one', () => {
+		expect( isCartItemImageList( [] ) ).toBe( true );
+		expect( isCartItemImageList( [ image( 1 ), image( 2 ) ] ) ).toBe(
+			true
+		);
+	} );
+
+	test( 'rejects anything else', () => {
+		expect( isCartItemImageList( 'a' ) ).toBe( false );
+		expect( isCartItemImageList( null ) ).toBe( false );
+		expect( isCartItemImageList( [ 'a' ] ) ).toBe( false );
+		expect( isCartItemImageList( [ null ] ) ).toBe( false );
+		expect( isCartItemImageList( [ [ image( 1 ) ] ] ) ).toBe( false );
+	} );
+
+	test( 'validation throws for invalid values', () => {
+		expect( cartItemImagesValidation( [ image( 1 ) ] ) ).toBe( true );
+		expect( () => cartItemImagesValidation( [ 'a' ] ) ).toThrow();
+	} );
+} );
+
+describe( 'getCartItemImages', () => {
+	test( 'returns only the first image without the filter script', () => {
+		const images = [ image( 1 ), image( 2 ) ];
+		expect(
+			getCartItemImages( { images, arg, applyFilter: undefined } )
+		).toEqual( [ image( 1 ) ] );
+	} );
+
+	test( 'returns an empty list for an item without images', () => {
+		expect(
+			getCartItemImages( { images: [], arg, applyFilter: undefined } )
+		).toEqual( [] );
+		expect(
+			getCartItemImages( {
+				images: undefined,
+				arg,
+				applyFilter: undefined,
+			} )
+		).toEqual( [] );
+	} );
+
+	test( 'does not run the filter when there is no cart item', () => {
+		const applyFilter = jest.fn() as unknown as ApplyCheckoutFilter;
+		expect(
+			getCartItemImages( { images: undefined, arg, applyFilter } )
+		).toEqual( [] );
+		expect( applyFilter ).not.toHaveBeenCalled();
+	} );
+
+	test( 'passes the first image, extensions and args to the filter', () => {
+		const applyFilter = jest.fn(
+			( { defaultValue }: { defaultValue: CartImageItem[] } ) =>
+				defaultValue
+		) as unknown as ApplyCheckoutFilter;
+		const extensions = { designer: { design_id: 9 } };
+
+		getCartItemImages( {
+			images: [ image( 1 ), image( 2 ) ],
+			extensions,
+			arg,
+			applyFilter,
+		} );
+
+		expect( applyFilter ).toHaveBeenCalledWith(
+			expect.objectContaining( {
+				filterName: 'cartItemImages',
+				defaultValue: [ image( 1 ) ],
+				extensions,
+				arg,
+				validation: cartItemImagesValidation,
+			} )
+		);
+	} );
+
+	test( 'falls back to the default when the filter returns a non-list', () => {
+		const applyFilter = ( () => 'nope' ) as unknown as ApplyCheckoutFilter;
+		expect(
+			getCartItemImages( {
+				images: [ image( 1 ), image( 2 ) ],
+				arg,
+				applyFilter,
+			} )
+		).toEqual( [ image( 1 ) ] );
+	} );
+
+	describe( 'with the checkout filter registry', () => {
+		test( 'returns the list a registered filter builds', () => {
+			const design = image( 99, 'Your design' );
+			registerCheckoutFilters( 'mini-cart-item-images-test', {
+				cartItemImages: ( value: unknown, extensions: unknown ) =>
+					( extensions as { designer?: unknown } ).designer
+						? [ design, ...( value as CartImageItem[] ) ]
+						: value,
+			} );
+
+			expect(
+				getCartItemImages( {
+					images: [ image( 1 ), image( 2 ) ],
+					extensions: { designer: {} },
+					arg: { ...arg, cartItem: { key: 'with-design' } },
+					applyFilter:
+						applyCheckoutFilter as unknown as ApplyCheckoutFilter,
+				} )
+			).toEqual( [ design, image( 1 ) ] );
+
+			// An item the filter leaves alone keeps its single image.
+			expect(
+				getCartItemImages( {
+					images: [ image( 3 ) ],
+					extensions: {},
+					arg: { ...arg, cartItem: { key: 'plain' } },
+					applyFilter:
+						applyCheckoutFilter as unknown as ApplyCheckoutFilter,
+				} )
+			).toEqual( [ image( 3 ) ] );
+		} );
+	} );
+} );
+
+describe( 'getItemImageAlt', () => {
+	const template = '%1$s, image %2$d of %3$d';
+
+	test( 'uses the image alt when it has one', () => {
+		expect(
+			getItemImageAlt( {
+				image: image( 1, 'Front' ),
+				template,
+				name: 'Shirt',
+				index: 0,
+				total: 2,
+			} )
+		).toBe( 'Front' );
+	} );
+
+	test( 'fills the template with the name and position', () => {
+		expect(
+			getItemImageAlt( {
+				image: image( 2 ),
+				template,
+				name: 'Shirt',
+				index: 1,
+				total: 3,
+			} )
+		).toBe( 'Shirt, image 2 of 3' );
+	} );
+
+	test( 'supports translations that reorder the placeholders', () => {
+		expect(
+			getItemImageAlt( {
+				image: undefined,
+				template: '%2$d/%3$d – %1$s',
+				name: 'Shirt',
+				index: 0,
+				total: 2,
+			} )
+		).toBe( '1/2 – Shirt' );
+	} );
+} );
