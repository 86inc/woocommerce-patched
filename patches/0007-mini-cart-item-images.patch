+++ b/plugins/woocommerce/client/blocks/assets/js/blocks/mini-cart/utils/item-images.ts
@@ -0,0 +1,125 @@
+/**
+ * Framework-free helpers that choose the images a Mini-Cart line item shows.
+ *
+ * Like `item-data.ts`, this module has no side effects and does not import
+ * `@wordpress/interactivity`, so it can be unit-tested without mocks.
+ */
+
+/**
+ * External dependencies
+ */
+import type { CartImageItem } from '@woocommerce/types';
+
+type FilterOptions = {
+	filterName: string;
+	defaultValue: CartImageItem[];
+	extensions?: Record< string, unknown > | null | undefined;
+	arg?: Record< string, unknown > | null;
+	validation?: ( value: CartImageItem[] ) => true | Error;
+};
+
+/**
+ * Shape of `wc.blocksCheckout.applyCheckoutFilter`, which may not be loaded.
+ */
+export type ApplyCheckoutFilter = ( options: FilterOptions ) => CartImageItem[];
+
+/**
+ * Whether a value is an array of image objects.
+ *
+ * @param value Value to check.
+ */
+export const isCartItemImageList = (
+	value: unknown
+): value is CartImageItem[] =>
+	Array.isArray( value ) &&
+	value.every(
+		( image ) =>
+			!! image && typeof image === 'object' && ! Array.isArray( image )
+	);
+
+/**
+ * Throws when a `cartItemImages` filter returns something other than an array
+ * of image objects, so the filter registry keeps the previous value.
+ *
+ * @param value Value returned by the filter.
+ */
+export const cartItemImagesValidation = ( value: unknown ): true => {
+	if ( ! isCartItemImageList( value ) ) {
+		throw new Error(
+			'The cartItemImages filter must return an array of image objects.'
+		);
+	}
+	return true;
+};
+
+/**
+ * Returns the images to show for a cart item: its first image by default, or
+ * the list returned by the `cartItemImages` checkout filter.
+ *
+ * @param props             Arguments.
+ * @param props.images      All images of the cart item.
+ * @param props.extensions  Extension data of the cart item.
+ * @param props.arg         Filter arguments (`context`, `cartItem`, `cart`).
+ * @param props.applyFilter `applyCheckoutFilter`, when the script is loaded.
+ */
+export const getCartItemImages = ( {
+	images,
+	extensions,
+	arg,
+	applyFilter,
+}: {
+	images: CartImageItem[] | undefined;
+	extensions?: Record< string, unknown > | undefined;
+	arg: Record< string, unknown >;
+	applyFilter?: ApplyCheckoutFilter | undefined;
+} ): CartImageItem[] => {
+	// No images array means no real cart item yet (e.g. an empty template row).
+	if ( ! Array.isArray( images ) ) {
+		return [];
+	}
+	const defaultValue = images.slice( 0, 1 );
+	if ( typeof applyFilter !== 'function' ) {
+		return defaultValue;
+	}
+	const value = applyFilter( {
+		filterName: 'cartItemImages',
+		defaultValue,
+		extensions,
+		arg,
+		validation: cartItemImagesValidation,
+	} );
+	return isCartItemImageList( value ) ? value : defaultValue;
+};
+
+/**
+ * Alt text for one image in a list: the image's own alt, or the template
+ * filled with the product name and the image's position.
+ *
+ * @param props          Arguments.
+ * @param props.image    The image.
+ * @param props.template Translated `%1$s, image %2$d of %3$d` template.
+ * @param props.name     Product name.
+ * @param props.index    Zero-based position of the image.
+ * @param props.total    Number of images.
+ */
+export const getItemImageAlt = ( {
+	image,
+	template,
+	name,
+	index,
+	total,
+}: {
+	image: Partial< CartImageItem > | undefined;
+	template: string;
+	name: string;
+	index: number;
+	total: number;
+} ): string => {
+	if ( image?.alt ) {
+		return image.alt;
+	}
+	return template
+		.replace( '%1$s', name )
+		.replace( '%2$d', String( index + 1 ) )
+		.replace( '%3$d', String( total ) );
+};
